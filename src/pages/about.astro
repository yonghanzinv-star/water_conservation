---
import Layout from "../layouts/Layout.astro";

const philosophy = [
    {
        title: "人本精神",
        description: "秉持人性化管理，重視員工思考、創意及自我管理能力。",
    },
    {
        title: "專業成長",
        description: "重視員工培訓及素質提升，鼓勵專業精進。",
    },
    {
        title: "務實創新",
        description: "發展兼顧創新、技術與實用性。",
    },
    {
        title: "核心價值",
        description: "堅持「誠信、高品質、高效率」的企業文化。",
    },
];
---

<Layout title="關於禾騰 - 禾騰技術">
    <!-- Page Banner -->
    <section class="page-banner">
        <div class="max-w-7xl mx-auto px-6">
            <span class="section-label section-label-light">About Us</span>
            <h1 class="text-4xl md:text-5xl font-bold">關於禾騰</h1>
        </div>
    </section>

    <!-- Company Profile -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Image -->
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-brand-blue to-brand-green"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1581092160607-ee22731a22e4?w=800&h=600&fit=crop&q=80"
                            alt="禾騰技術團隊"
                            class="w-full h-full object-cover mix-blend-overlay opacity-60"
                        />
                        <div
                            class="absolute inset-0 flex items-center justify-center"
                        >
                            <div class="text-center text-white">
                                <div class="text-6xl font-bold mb-2">2012</div>
                                <div class="text-lg">成立於新北市</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Content -->
                <div>
                    <span class="section-label">公司簡介</span>
                    <h2 class="section-title mb-6">跨域整合的工程顧問</h2>
                    <div class="space-y-4 text-text-body leading-relaxed">
                        <p>
                            禾騰技術股份有限公司成立於 2012 年 12
                            月，總部位於新北市新莊區。我們長期投入<strong
                                class="text-text-title"
                                >農業水利、集水區治理及低碳永續工程</strong
                            >領域。
                        </p>
                        <p>
                            不同於傳統工程顧問，我們運用工程結合新興科技，協助政府部門促進農業永續與公共韌性提升。
                        </p>
                    </div>

                    <!-- Stats -->
                    <div class="grid grid-cols-3 gap-6 mt-8 pt-8 border-t">
                        <div>
                            <div class="text-3xl font-bold text-brand-blue">
                                10+
                            </div>
                            <div class="text-sm text-text-muted">
                                年專業經驗
                            </div>
                        </div>
                        <div>
                            <div class="text-3xl font-bold text-brand-green">
                                100+
                            </div>
                            <div class="text-sm text-text-muted">專案實績</div>
                        </div>
                        <div>
                            <div class="text-3xl font-bold text-accent-sky">
                                3
                            </div>
                            <div class="text-sm text-text-muted">核心領域</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Vision & Mission -->
    <section class="py-16 lg:py-24 bg-bg-light">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Vision -->
                <div class="card bg-brand-blue text-white">
                    <div class="icon-box bg-white/20 mb-6">
                        <svg
                            class="w-7 h-7 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">願景 Vision</h3>
                    <p class="text-white/90 text-lg leading-relaxed">
                        以跨域工程與智慧科技，打造韌性永續未來。
                    </p>
                </div>

                <!-- Mission -->
                <div class="card bg-brand-green text-white">
                    <div class="icon-box bg-white/20 mb-6">
                        <svg
                            class="w-7 h-7 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">使命 Mission</h3>
                    <p class="text-white/90 text-lg leading-relaxed">
                        帶著回饋土地的使命，運用工程結合新科技，搭配自然與文化的涵養，解決跨領域的複雜議題。
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Philosophy -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <span class="section-label">經營理念</span>
                <h2 class="section-title">我們的核心信念</h2>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    philosophy.map((item, index) => (
                        <div class="card-bordered text-center">
                            <div class="w-12 h-12 rounded-full bg-brand-blue/10 text-brand-blue font-bold text-xl flex items-center justify-center mx-auto mb-4">
                                {index + 1}
                            </div>
                            <h3 class="text-lg font-bold text-text-title mb-2">
                                {item.title}
                            </h3>
                            <p class="text-text-body text-sm">
                                {item.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
