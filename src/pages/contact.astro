---
import Layout from "../layouts/Layout.astro";
---

<Layout title="聯絡我們 - 禾騰技術">
    <!-- Page Banner -->
    <section class="page-banner relative">
        <div class="max-w-7xl mx-auto px-6 relative z-10">
            <span class="section-label section-label-light">Contact</span>
            <h1 class="text-4xl md:text-5xl font-bold">聯絡我們</h1>
            <p class="text-xl text-white/80 mt-4 max-w-2xl">
                歡迎與我們洽談專案合作或人才招募事宜
            </p>
        </div>
		<!-- Decorative Elements: 波浪形分界線 -->
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
			<svg class="relative block w-full h-[30px] md:h-[60px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32L1440,120L0,120Z" fill="#FFFFFF"></path>
			</svg>
		</div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 lg:py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
                <!-- Contact Info -->
                <div>
                    <span class="section-label">聯絡資訊</span>
                    <h2 class="section-title mb-8">與我們取得聯繫</h2>

                    <div class="space-y-6">
                        <!-- Address -->
                        <div class="flex items-start gap-4">
                            <div class="icon-box icon-box-blue shrink-0">
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-bold text-text-title mb-1">
                                    公司地址
                                </h3>
                                <p class="text-text-body">
                                    新北市新莊區新北大道三段 7 號 2 樓 6A
                                </p>
                                <p class="text-sm text-text-muted mt-1">
                                    近機捷新莊副都心站
                                </p>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="flex items-start gap-4">
                            <div class="icon-box icon-box-green shrink-0">
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-bold text-text-title mb-1">
                                    聯絡電話
                                </h3>
                                <a
                                    href="tel:02-8521-9296"
                                    class="text-brand-blue hover:underline"
                                >
                                    02-8521-9296
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Business Hours -->
                    <div class="mt-8 p-6 bg-bg-light rounded-xl">
                        <h3 class="font-bold text-text-title mb-3">營業時間</h3>
                        <div class="space-y-2 text-text-body">
                            <div class="flex justify-between">
                                <span>週一至週五</span>
                                <span class="font-medium">09:00 - 18:00</span>
                            </div>
                            <div class="flex justify-between">
                                <span>週六、週日</span>
                                <span class="text-text-muted">休息</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div>
                    <div class="card bg-white">
                        <h3 class="text-xl font-bold text-text-title mb-6">
                            業務諮詢表單
                        </h3>

                        <form class="space-y-5">
                            <div class="grid md:grid-cols-2 gap-5">
                                <div>
                                    <label
                                        for="name"
                                        class="block text-sm font-medium text-text-title mb-2"
                                    >
                                        姓名 <span class="text-brand-accent"
                                            >*</span
                                        >
                                    </label>
                                    <input
                                        type="text"
                                        id="name"
                                        name="name"
                                        required
                                        class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-all"
                                        placeholder="您的姓名"
                                    />
                                </div>
                                <div>
                                    <label
                                        for="company"
                                        class="block text-sm font-medium text-text-title mb-2"
                                    >
                                        公司名稱
                                    </label>
                                    <input
                                        type="text"
                                        id="company"
                                        name="company"
                                        class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-all"
                                        placeholder="公司或機關名稱"
                                    />
                                </div>
                            </div>

                            <div class="grid md:grid-cols-2 gap-5">
                                <div>
                                    <label
                                        for="email"
                                        class="block text-sm font-medium text-text-title mb-2"
                                    >
                                        電子郵件 <span class="text-brand-accent"
                                            >*</span
                                        >
                                    </label>
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        required
                                        class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-all"
                                        placeholder="your@email.com"
                                    />
                                </div>
                                <div>
                                    <label
                                        for="phone"
                                        class="block text-sm font-medium text-text-title mb-2"
                                    >
                                        聯絡電話
                                    </label>
                                    <input
                                        type="tel"
                                        id="phone"
                                        name="phone"
                                        class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-all"
                                        placeholder="02-XXXX-XXXX"
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    for="subject"
                                    class="block text-sm font-medium text-text-title mb-2"
                                >
                                    諮詢類型 <span class="text-brand-accent"
                                        >*</span
                                    >
                                </label>
                                <select
                                    id="subject"
                                    name="subject"
                                    required
                                    class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-all bg-white"
                                >
                                    <option value="">請選擇</option>
                                    <option value="project">專案合作洽談</option
                                    >
                                    <option value="service">服務諮詢</option>
                                    <option value="career">人才招募</option>
                                    <option value="other">其他</option>
                                </select>
                            </div>

                            <div>
                                <label
                                    for="message"
                                    class="block text-sm font-medium text-text-title mb-2"
                                >
                                    諮詢內容 <span class="text-brand-accent"
                                        >*</span
                                    >
                                </label>
                                <textarea
                                    id="message"
                                    name="message"
                                    rows="5"
                                    required
                                    class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-all resize-none"
                                    placeholder="請描述您的需求或問題..."
                                ></textarea>
                            </div>

                            <button type="submit" class="btn-primary w-full">
                                送出諮詢
                            </button>

                            <p class="text-xs text-text-muted text-center">
                                提交表單即表示您同意我們的隱私權政策
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
		<!-- Decorative Elements: 波浪形分界線 -->
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
			<svg class="relative block w-full h-[30px] md:h-[60px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32L1440,120L0,120Z" fill="#F5F7F6"></path>
			</svg>
		</div>
    </section>

    <!-- Map Section -->
    <section class="bg-bg-light relative pb-16">
        <div class="max-w-7xl mx-auto px-6 py-12">
            <a
                href="https://maps.app.goo.gl/cJmdw6ZWeDKRnmjE9"
                target="_blank"
                rel="noopener noreferrer"
                class="block aspect-[21/9] rounded-2xl overflow-hidden bg-gray-200 relative group"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3614.7!2d121.4489!3d25.0464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3442a9b3e2d7bb17%3A0x1f8b5b8a2e4c1d0a!2z5paw5YyX5biC5paw6I6K5Y2A5paw5YyX5aSn6YGT5LiJ5q61N-iZnw!5e0!3m2!1szh-TW!2stw!4v1707380000000!5m2!1szh-TW!2stw"
                    width="100%"
                    height="100%"
                    style="border:0; pointer-events:none;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="禾騰技術位置"></iframe>
                <div
                    class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center"
                >
                    <span
                        class="opacity-0 group-hover:opacity-100 bg-white px-4 py-2 rounded-lg shadow-lg text-text-title font-medium transition-opacity"
                    >
                        點擊在 Google Maps 中開啟
                    </span>
                </div>
            </a>
            <p class="text-center text-text-muted mt-4 text-sm relative z-10">
                📍 新北市新莊區新北大道三段 7 號 2 樓 6A（近機捷新莊副都心站）
            </p>
        </div>
		<!-- Decorative Elements: 與 Footer 接合的波浪 -->
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none text-brand-blue">
			<svg class="relative block w-full h-[40px] md:h-[80px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,32L80,48C160,64,320,96,480,96C640,96,800,64,960,53.3C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z" fill="currentColor"></path>
			</svg>
		</div>
    </section>
</Layout>
