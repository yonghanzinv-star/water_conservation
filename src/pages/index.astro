---
import Layout from "../layouts/Layout.astro";

// 三大核心領域
const expertise = [
	{
		icon: "water",
		title: "流域管理與防災應用",
		description: "結合水文分析與防災科技，建構坡地與河川的安全防護網。",
		link: "/services#watershed",
	},
	{
		icon: "agriculture",
		title: "農業發展與水資源保育",
		description: "透過智慧水資源調度與精準灌溉，推動農業環境的永續發展。",
		link: "/services#agriculture",
	},
	{
		icon: "sustainability",
		title: "永續發展與景觀遊憩",
		description: "融合景觀美學與淨零碳排策略，營造具備地方特色的遊憩環境。",
		link: "/services#sustainability",
	},
];

// 精選實績
const highlights = [
	{
		category: "智慧防災",
		title: "洪水預警及防汛整合作業",
		client: "經濟部水利署",
	},
	{
		category: "農業水利",
		title: "擴大灌溉服務推動計畫",
		client: "農業部農田水利署",
	},
	{
		category: "景觀專案",
		title: "體驗觀光地方旅遊環境營造",
		client: "交通部觀光局",
	},
];
---

<Layout title="[預覽] 禾騰技術 - 以跨域工程與智慧科技，打造韌性永續未來">
	<!-- 區塊1: Hero Section (Mixed 原站深色升級 + 光暈效果) -->
	<section
		class="relative bg-gradient-to-b from-[#112239] via-brand-blue to-[#1a3821] min-h-[90vh] flex items-center overflow-hidden"
	>
		<!-- Background 光暈、粒子與動態流動線條裝飾 -->
		<div class="absolute inset-0 opacity-20">
			<div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-white/10 to-transparent"></div>
		</div>
		
		<!-- 動態科技流動線帶 (Tech Flowing Ribbons) -->
		<div class="absolute inset-0 overflow-hidden pointer-events-none opacity-50 mix-blend-screen">
			<!-- Ribbon 1 -->
			<svg class="absolute w-[400%] h-full top-0 left-0 animated-ribbon text-white/20" viewBox="0 0 400 100" preserveAspectRatio="none">
				<path d="M 0 50 Q 25 20 50 50 T 100 50 Q 125 20 150 50 T 200 50 Q 225 20 250 50 T 300 50 Q 325 20 350 50 T 400 50" fill="none" stroke="currentColor" stroke-width="0.5" />
			</svg>
			<!-- Ribbon 2 -->
			<svg class="absolute w-[400%] h-full top-0 left-0 animated-ribbon ribbon-reverse text-accent-sky/30" viewBox="0 0 400 100" preserveAspectRatio="none">
				<path d="M 0 50 Q 25 80 50 50 T 100 50 Q 125 80 150 50 T 200 50 Q 225 80 250 50 T 300 50 Q 325 80 350 50 T 400 50" fill="none" stroke="currentColor" stroke-width="2" />
			</svg>
			<!-- Ribbon 3 -->
			<svg class="absolute w-[400%] h-full top-0 left-0 animated-ribbon ribbon-slow text-brand-green-light/40" viewBox="0 0 400 100" preserveAspectRatio="none">
				<path d="M 0 50 Q 25 35 50 50 T 100 50 Q 125 35 150 50 T 200 50 Q 225 35 250 50 T 300 50 Q 325 35 350 50 T 400 50" fill="none" stroke="currentColor" stroke-width="2.5" />
				<path d="M 0 50 Q 25 35 50 50 T 100 50 Q 125 35 150 50 T 200 50 Q 225 35 250 50 T 300 50 Q 325 35 350 50 T 400 50" fill="none" stroke="currentColor" stroke-width="12" style="filter:blur(6px)" class="opacity-50" />
			</svg>
		</div>
		<div class="absolute top-1/4 -right-20 w-96 h-96 rounded-full bg-brand-green-light/20 blur-[100px] pointer-events-none"></div>
		<div class="absolute bottom-1/4 -left-20 w-80 h-80 rounded-full bg-accent-sky/20 blur-[100px] pointer-events-none"></div>

		<div class="relative z-20 max-w-7xl mx-auto px-6 py-24 lg:py-32 w-full">
			<div class="max-w-3xl scroll-reveal" style="transition-delay: 0.1s">
				<!-- Badge -->
				<div
					class="inline-flex items-center gap-2 px-4 py-2 rounded-full mixed-dark-glass text-white border border-white/20 mb-8 shadow-xl"
				>
					<span class="text-sm font-medium tracking-wide">
						跨域整合的工程顧問 ・ 創新與實務並進
					</span>
				</div>

				<!-- Main Headline -->
				<h1
					class="text-[1.75rem] sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6 drop-shadow-lg"
				>
					<span class="inline-block whitespace-nowrap">以跨域工程與智慧科技，</span><br />
					<span class="text-accent-olive">打造韌性永續未來</span>
				</h1>

				<!-- Sub-headline -->
				<p class="text-xl md:text-2xl text-white/90 max-w-2xl mb-10 leading-relaxed font-medium">
					運用創新技術與自然涵養，解決複雜跨域議題，<br class="hidden sm:block" />
					成為推動農業永續與公共韌性的關鍵力量。
				</p>

				<!-- CTA Buttons -->
				<div class="flex flex-wrap gap-5 scroll-reveal" style="transition-delay: 0.3s">
					<a href="/services" class="inline-flex items-center justify-center px-8 py-4 rounded-xl font-semibold text-brand-blue bg-white hover:bg-gray-50 transition-all shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:shadow-[0_0_30px_rgba(255,255,255,0.5)] hover:-translate-y-1"> 
						探索專業服務 
					</a>
					<a
						href="/about"
						class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold text-white border-2 border-white/30 hover:bg-white/10 transition-all hover:border-white/60 hover:-translate-y-1"
					>
						認識禾騰
						<svg
							class="w-5 h-5 transition-transform group-hover:translate-x-1"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>

		<!-- Decorative Elements: 波浪形分界線 (降低飽和度與高度，不遮擋主要內容) -->
		<div class="absolute bottom-[0px] left-0 right-0 w-full overflow-visible leading-none z-10 pointer-events-none drop-shadow-lg">
			<svg class="relative block w-full h-[60px] md:h-[120px] overflow-visible" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<!-- Deep Blue Layer (changed to subdued slate blue) -->
				<path d="M0,0L60,10.7C120,21,240,43,360,37.3C480,32,600,0,720,-5.3C840,-11,960,11,1080,16C1200,21,1320,11,1380,5.3L1440,0L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z" fill="#2B4A6A" opacity="0.8"></path>
				<!-- Sky/Teal Layer (changed to muted teal slate) -->
				<path d="M0,32L60,42.7C120,53,240,75,360,69.3C480,64,600,32,720,26.7C840,21,960,43,1080,48C1200,53,1320,43,1380,37.3L1440,32L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z" fill="#4B6B78" opacity="0.85"></path>
				<!-- Brand Green Layer (changed to subdued dark sage) -->
				<path d="M0,64L60,58.7C120,53,240,43,360,53.3C480,64,600,96,720,96C840,96,960,64,1080,53.3C1200,43,1320,53,1380,58.7L1440,64L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z" fill="#6D8B74" opacity="0.9"></path>
				<!-- Base Layer -->
				<path d="M0,96L60,85.3C120,75,240,53,360,53.3C480,53,600,75,720,80C840,85,960,75,1080,64C1200,53,1320,43,1380,37.3L1440,32L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z" fill="#F5F7F6"></path>
			</svg>
		</div>
	</section>

	<!-- 區塊2: Mission Quote Section -->
	<section class="py-20 lg:py-32 bg-bg-light overflow-hidden relative z-10">
		<!-- 背景裝飾字體 -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[15vw] font-bold text-gray-900/[0.02] whitespace-nowrap pointer-events-none select-none z-0">
			MISSION
		</div>
		
		<div class="max-w-4xl mx-auto px-6 text-center relative z-10 scroll-reveal">
			<blockquote class="relative mixed-glass p-12 md:p-16 rounded-3xl shadow-xl">
				<svg
					class="absolute top-6 left-6 md:top-8 md:left-8 w-12 h-12 text-brand-green/20"
					fill="currentColor"
					viewBox="0 0 24 24"
				>
					<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
				</svg>
				<p class="text-2xl md:text-3xl lg:text-4xl text-text-title font-medium leading-relaxed mb-8 relative z-10 text-balance">
					帶著回饋土地的使命，運用工程結合新科技，搭配自然與文化的涵養，解決跨領域的複雜議題。
				</p>
				<cite class="text-xl text-brand-green font-bold not-italic flex items-center justify-center gap-4">
					<span class="w-12 h-0.5 bg-brand-green"></span>
					禾騰技術
					<span class="w-12 h-0.5 bg-brand-green"></span>
				</cite>
			</blockquote>
		</div>

		<!-- Decorative Elements: 波浪形分界線 -->
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">

			<svg class="relative block w-full h-[50px] md:h-[80px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z" fill="#FFFFFF"></path>
			</svg>
		</div>
	</section>

	<!-- 區塊3: Core Expertise Section -->
	<section class="py-20 lg:py-32 bg-white relative z-40">
		<!-- 飄動流線點綴 (跨越 Y 軸邊界的全域最上層 z-50) -->
		<div class="absolute inset-x-0 top-0 bottom-0 pointer-events-none z-50">
			<!-- Top Edge Echo (負座標往上延伸進入前一區塊波浪) -->
			<svg class="absolute top-[-25px] md:top-[-45px] left-0 w-full h-[50px] md:h-[80px] text-brand-blue/20 animate-float-1 drop-shadow-sm" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32" fill="none" stroke="currentColor" stroke-width="2" />
			</svg>
			<svg class="absolute top-[-10px] md:top-[-20px] left-0 w-full h-[40px] md:h-[60px] text-brand-green/20 animate-float-2 drop-shadow-sm" viewBox="0 0 1440 120" preserveAspectRatio="none" style="animation-duration: 8s;">
				<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32" fill="none" stroke="currentColor" stroke-width="4" />
			</svg>

			<!-- Bottom Edge Echo (負座標往下延伸進入後一區塊波浪) -->
			<svg class="absolute bottom-[-15px] md:bottom-[-25px] left-0 w-full h-[60px] md:h-[90px] text-brand-blue/20 animate-float-1 drop-shadow-sm" viewBox="0 0 1440 120" preserveAspectRatio="none" style="animation-duration: 6s; animation-direction: reverse;">
				<path d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64" fill="none" stroke="currentColor" stroke-width="2" />
			</svg>
			<svg class="absolute bottom-[-25px] md:bottom-[-45px] left-0 w-full h-[50px] md:h-[70px] text-brand-green/20 animate-float-2 drop-shadow-sm" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64" fill="none" stroke="currentColor" stroke-width="4" />
			</svg>
		</div>
		
		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<!-- Section Header -->
			<div class="text-center mb-16 scroll-reveal">
				<span class="section-label tracking-widest text-brand-blue bg-blue-50 px-4 py-1.5 rounded-full mb-4 inline-block">核心領域</span>
				<h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">三大專業服務</h2>
				<p class="text-lg text-text-body max-w-2xl mx-auto">
					整合工程專業與創新科技，為政府機關與民間單位提供全方位解決方案
				</p>
			</div>

			<!-- Expertise Cards (Stagger 進場) -->
			<div class="grid md:grid-cols-3 gap-8">
				{
					expertise.map((item, index) => (
						<a 
							href={item.link} 
							class="scroll-reveal group block h-full"
							style={`transition-delay: ${index * 150}ms`}
						>
							<div class="card-bordered bg-white h-full border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:border-transparent transition-all duration-500 ease-out flex flex-col hover:-translate-y-2 rounded-2xl relative overflow-hidden">
								
								<!-- Hover Color Sweep Effect -->
								<div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-brand-blue to-brand-green transform translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>

								<div
									class={`w-16 h-16 rounded-2xl mb-8 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3 ${
										item.icon === "water" ? "bg-blue-50 text-brand-blue" : 
										item.icon === "agriculture" ? "bg-sky-50 text-accent-sky" : 
										"bg-green-50 text-brand-green"
									}`}
								>
									{item.icon === "water" && (
										<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
										</svg>
									)}
									{item.icon === "agriculture" && (
										<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
										</svg>
									)}
									{item.icon === "sustainability" && (
										<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
										</svg>
									)}
								</div>
								
								<h3 class="text-2xl font-bold text-text-title mb-4 transition-colors group-hover:text-brand-blue">
									{item.title}
								</h3>
								<p class="text-text-body text-[1.05rem] leading-relaxed mb-8 flex-grow">
									{item.description}
								</p>
								
								<div class="inline-flex items-center text-brand-blue font-bold text-base transition-all group-hover:tracking-wide">
									了解更多
									<svg class="w-5 h-5 ml-1 transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
									</svg>
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>

		<!-- Decorative Elements: 波浪形分界線 -->
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
			<svg class="relative block w-full h-[60px] md:h-[100px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,96L80,85.3C160,75,320,53,480,58.7C640,64,800,96,960,96C1120,96,1280,64,1360,48L1440,32L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z" fill="#F5F7F6"></path>
			</svg>
		</div>
	</section>

	<!-- 區塊4: Highlights Section -->
	<section class="py-20 lg:py-32 bg-bg-light relative overflow-hidden">
		<div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-white/40 to-transparent pointer-events-none"></div>
		
		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<!-- Section Header -->
			<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16 scroll-reveal">
				<div>
					<span class="section-label tracking-widest text-brand-green bg-green-50 px-4 py-1.5 rounded-full mb-4 inline-block">最新動態</span>
					<h2 class="text-4xl md:text-5xl font-bold text-gray-900">精選實績</h2>
				</div>
				<a href="/portfolio" class="inline-flex items-center gap-2 text-brand-blue font-bold hover:bg-white hover:shadow-lg px-6 py-3 rounded-full transition-all hover:-translate-y-0.5 bg-white/50 backdrop-blur-sm border border-gray-200">
					查看所有案例
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</a>
			</div>

			<!-- Highlight Cards -->
			<div class="grid md:grid-cols-3 gap-8">
				{
					highlights.map((item, index) => (
						<div 
							class="scroll-reveal group h-full"
							style={`transition-delay: ${index * 150}ms`}
						>
							<div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-[0_15px_30px_rgba(0,0,0,0.06)] hover:-translate-y-2 transition-all duration-300 h-full flex flex-col relative overflow-hidden">
								<!-- Subtle glow on hover -->
								<div class="absolute inset-0 bg-gradient-to-br from-brand-green/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
								<div class="relative z-10">
									<span class="inline-block px-3 py-1 font-medium text-xs rounded-full bg-green-50 text-brand-green mb-5">
										{item.category}
									</span>
									<h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-brand-blue transition-colors">
										{item.title}
									</h3>
									<div class="mt-auto flex items-center gap-2 pt-4 border-t border-gray-50">
										<svg class="w-4 h-4 text-gray-400 group-hover:text-brand-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
										</svg>
										<p class="text-sm text-gray-500 font-medium">{item.client}</p>
									</div>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section
		class="py-32 lg:py-40 bg-gradient-to-br from-brand-blue via-brand-green to-[#1a3821] relative overflow-hidden"
	>
		<!-- Decorative Elements: 頂部向下切入的波浪 -->
		<div class="absolute top-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none transform rotate-180">
			<!-- 白波浪基底 -->
			<svg class="relative block w-full h-[60px] md:h-[100px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
