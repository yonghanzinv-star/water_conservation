---
import Layout from '../layouts/Layout.astro';

const portfolioCategories = [
  {
    id: "disaster",
    title: "智慧防災",
    icon: "shield",
    projects: [
      {
        title: "洪水預警及防汛整合作業",
        client: "經濟部水利署第九河川分署",
        year: "113-114",
        description: "建置轄區洪水預警模式及整合防汛作業系統"
      },
      {
        title: "土石流及大規模崩塌防災整備與緊急應變計畫",
        client: "農業部農村發展及水土保持署花蓮分署",
        year: "112-113",
        description: "規劃土石流防災整備及緊急應變機制"
      }
    ]
  },
  {
    id: "irrigation",
    title: "農業水利擴大灌溉",
    icon: "water",
    projects: [
      {
        title: "通霄、大湖地區擴大灌溉服務推動計畫",
        client: "農業部農田水利署苗栗管理處",
        year: "112-114",
        description: "推動苗栗地區擴大灌溉服務"
      },
      {
        title: "瑞穗鄉舞鶴地區擴大灌溉服務",
        client: "農業部農田水利署花蓮管理處",
        year: "111-113",
        description: "規劃花蓮瑞穗舞鶴地區灌溉系統"
      },
      {
        title: "臺東縱谷沿線擴大灌溉服務推動",
        client: "農業部農田水利署臺東管理處",
        year: "112-114",
        description: "推動臺東縱谷地區擴大灌溉"
      }
    ]
  },
  {
    id: "landscape",
    title: "景觀與專案管理",
    icon: "tree",
    projects: [
      {
        title: "體驗觀光地方旅遊環境營造計畫專案管理",
        client: "交通部觀光署",
        year: "112-114",
        description: "協助觀光署推動地方旅遊環境營造"
      },
      {
        title: "重要廊帶亮點營造計畫專案管理服務",
        client: "交通部觀光署",
        year: "111-113",
        description: "規劃管理重要觀光廊帶亮點計畫"
      },
      {
        title: "雪霧鬧野溪資源盤查與步道活化",
        client: "桃園市政府風景區管理處",
        year: "112",
        description: "盤點復興區野溪資源並活化步道系統"
      }
    ]
  }
];
---

<Layout title="實績案例 - 禾騰技術">
  <!-- Page Banner -->
  <section class="page-banner relative">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <span class="section-label section-label-light">Portfolio</span>
      <h1 class="text-4xl md:text-5xl font-bold">實績案例</h1>
      <p class="text-xl text-white/80 mt-4 max-w-2xl">
        精選近年代表性計畫，展現跨域整合能力
      </p>
    </div>
	<!-- Decorative Elements: 波浪形分界線 -->
	<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
		<svg class="relative block w-full h-[30px] md:h-[60px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
			<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32L1440,120L0,120Z" fill="#FFFFFF"></path>
		</svg>
	</div>
  </section>
  
  <!-- Portfolio Categories -->
  {portfolioCategories.map((category, index) => (
    <section id={category.id} class={`py-16 lg:py-20 relative ${index % 2 === 0 ? 'bg-white' : 'bg-bg-light'}`}>
      <div class="max-w-7xl mx-auto px-6">
        <!-- Category Header -->
        <div class="flex items-center gap-4 mb-8">
          <div class="icon-box icon-box-blue">
            {category.icon === 'shield' && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            )}
            {category.icon === 'water' && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
              </svg>
            )}
            {category.icon === 'tree' && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
              </svg>
            )}
          </div>
          <h2 class="text-2xl font-bold text-text-title">{category.title}</h2>
        </div>
        
        <!-- Project Cards -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {category.projects.map((project) => (
            <div class="card bg-white group">
              <div class="flex items-center justify-between mb-4">
                <span class="tag">{project.year}</span>
              </div>
              <h3 class="text-lg font-bold text-text-title mb-2 group-hover:text-brand-blue transition-colors">
                {project.title}
              </h3>
              <p class="text-sm text-text-muted mb-3">{project.client}</p>
              <p class="text-sm text-text-body">{project.description}</p>
            </div>
          ))}
        </div>
      </div>
	  {/* Decorative Elements: 波浪形分界線 (最後一個項目不加底部波浪，因為下方接著 CTA) */}
	  {index < portfolioCategories.length - 1 && (
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
			<svg class="relative block w-full h-[30px] md:h-[60px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,53.3C160,43,320,21,480,26.7C640,32,800,64,960,69.3C1120,75,1280,53,1360,42.7L1440,32L1440,120L0,120Z" fill={index % 2 === 0 ? '#F5F7F6' : '#FFFFFF'}></path>
			</svg>
		</div>
	  )}
    </section>
  ))}
  
	<!-- CTA Section -->
	<section
		class="py-32 lg:py-40 bg-gradient-to-br from-brand-blue via-brand-green to-[#1a3821] relative overflow-hidden"
	>
		<!-- Decorative Elements: 向下漸層波浪 (與上一個 bg-bg-light 區塊的結尾銜接) -->
		<div class="absolute top-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none transform rotate-180">
			<svg class="relative block w-full h-[60px] md:h-[100px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z" fill="#F5F7F6"></path>
			</svg>
		</div>

		<!-- 漂浮圈圈 -->
		<div class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 rounded-full border-[20px] border-white/5 pointer-events-none" style="animation: float-circle 6s ease-in-out infinite;"></div>
		<div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full border-[20px] border-white/5 pointer-events-none" style="animation: float-circle 7s ease-in-out infinite reverse;"></div>
		
		<div class="max-w-4xl mx-auto px-6 text-center relative z-10">
			<h2 class="text-4xl md:text-5xl font-bold text-white mb-8 drop-shadow-md">
				想了解更多專案細節？
			</h2>
			<p class="text-xl text-white/90 max-w-2xl mx-auto mb-12 font-light">
				歡迎與我們聯繫，討論您的專案需求
			</p>
			<a href="/contact" class="inline-flex items-center justify-center px-10 py-4 rounded-xl font-bold text-brand-blue bg-white hover:scale-105 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.2)]">
				聯絡我們
			</a>
		</div>

		<!-- Decorative Elements: 與 Footer 接合的波浪 -->
		<div class="absolute bottom-[-1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none text-brand-blue">
			<svg class="relative block w-full h-[40px] md:h-[80px]" viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path d="M0,32L80,48C160,64,320,96,480,96C640,96,800,64,960,53.3C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z" fill="currentColor"></path>
			</svg>
		</div>
	</section>
</Layout>
