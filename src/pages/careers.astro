---
import Layout from "../layouts/Layout.astro";

const benefits = [
    {
        category: "獎金分紅",
        items: ["年終獎金", "績效獎金", "績優員工分紅", "員工紅利"],
    },
    {
        category: "身心平衡",
        items: [
            "週休二日",
            "優於勞基法特休假",
            "年度國內外旅遊",
            "員工聚餐活動",
        ],
    },
    {
        category: "成長支持",
        items: [
            "完整教育訓練",
            "專業證照補助",
            "升遷制度透明",
            "跨部門學習機會",
        ],
    },
];

const openings = [
    {
        title: "水利工程師",
        department: "流域管理部",
        type: "全職",
        requirements: ["土木/水利相關科系", "熟悉 AutoCAD", "具備相關證照優先"],
    },
    {
        title: "土木大地工程師",
        department: "流域管理部",
        type: "全職",
        requirements: ["土木/大地相關科系", "熟悉地質分析", "3年以上經驗"],
    },
    {
        title: "景觀規劃師",
        department: "永續發展部",
        type: "全職",
        requirements: [
            "景觀/都市計畫相關科系",
            "熟悉 GIS 軟體",
            "具專案管理經驗優先",
        ],
    },
    {
        title: "專案管理師",
        department: "專案管理中心",
        type: "全職",
        requirements: [
            "相關工程或管理背景",
            "具 PMP 證照優先",
            "良好溝通協調能力",
        ],
    },
];

const travelPhotos = ["澳洲", "宿霧", "巴拉望"];
---

<Layout title="加入我們 - 禾騰技術">
    <!-- Page Banner -->
    <section class="page-banner">
        <div class="max-w-7xl mx-auto px-6">
            <span class="section-label section-label-light">Careers</span>
            <h1 class="text-4xl md:text-5xl font-bold">加入我們</h1>
            <p class="text-xl text-white/80 mt-4 max-w-2xl">
                與我們共同解決土地的複雜議題，創造有意義的影響力
            </p>
        </div>
    </section>

    <!-- Culture Section -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <!-- Content -->
                <div>
                    <span class="section-label">人才理念</span>
                    <h2 class="section-title mb-6">員工是最重要資產</h2>
                    <p class="text-text-body text-lg leading-relaxed mb-6">
                        禾騰視員工為最重要資產，我們提供具高度發展潛力與競爭優勢的工作環境。在這裡，您可以充分發揮專業與熱忱，與我們共同解決土地的複雜議題。
                    </p>
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <div
                                class="w-6 h-6 rounded-full bg-brand-green/10 flex items-center justify-center mt-0.5"
                            >
                                <svg
                                    class="w-4 h-4 text-brand-green"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-text-body"
                                >人性化管理，重視思考與創意</span
                            >
                        </div>
                        <div class="flex items-start gap-3">
                            <div
                                class="w-6 h-6 rounded-full bg-brand-green/10 flex items-center justify-center mt-0.5"
                            >
                                <svg
                                    class="w-4 h-4 text-brand-green"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-text-body"
                                >完整培訓制度，鼓勵專業精進</span
                            >
                        </div>
                        <div class="flex items-start gap-3">
                            <div
                                class="w-6 h-6 rounded-full bg-brand-green/10 flex items-center justify-center mt-0.5"
                            >
                                <svg
                                    class="w-4 h-4 text-brand-green"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-text-body"
                                >跨領域專案，累積多元經驗</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Image Placeholder -->
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-brand-blue to-accent-sky"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&h=600&fit=crop&q=80"
                            alt="團隊合作"
                            class="w-full h-full object-cover mix-blend-overlay"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-16 lg:py-24 bg-bg-light">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <span class="section-label">幸福職場</span>
                <h2 class="section-title">福利制度</h2>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                {
                    benefits.map((benefit) => (
                        <div class="card bg-white">
                            <h3 class="text-xl font-bold text-text-title mb-4">
                                {benefit.category}
                            </h3>
                            <ul class="space-y-3">
                                {benefit.items.map((item) => (
                                    <li class="flex items-center gap-3 text-text-body">
                                        <svg
                                            class="w-5 h-5 text-brand-green shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 13l4 4L19 7"
                                            />
                                        </svg>
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>

            <!-- Travel Highlight -->
            <div class="mt-12 p-6 bg-white rounded-2xl border border-gray-100">
                <div
                    class="flex flex-col md:flex-row items-center justify-between gap-6"
                >
                    <div>
                        <h3 class="text-lg font-bold text-text-title mb-2">
                            ✈️ 年度員工旅遊
                        </h3>
                        <p class="text-text-body">
                            曾出遊至{travelPhotos.join("、")}等地
                        </p>
                    </div>
                    <div class="flex -space-x-4">
                        <div
                            class="w-16 h-16 rounded-full bg-accent-sky flex items-center justify-center text-white font-bold"
                        >
                            🇦🇺
                        </div>
                        <div
                            class="w-16 h-16 rounded-full bg-brand-green flex items-center justify-center text-white font-bold"
                        >
                            🇵🇭
                        </div>
                        <div
                            class="w-16 h-16 rounded-full bg-brand-blue flex items-center justify-center text-white font-bold"
                        >
                            🌴
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Openings Section -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <span class="section-label">熱門職缺</span>
                <h2 class="section-title">我們正在尋找</h2>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                {
                    openings.map((job) => (
                        <div class="card-bordered group hover:border-brand-blue">
                            <div class="flex items-start justify-between mb-4">
                                <div>
                                    <h3 class="text-xl font-bold text-text-title group-hover:text-brand-blue transition-colors">
                                        {job.title}
                                    </h3>
                                    <p class="text-sm text-text-muted">
                                        {job.department}
                                    </p>
                                </div>
                                <span class="tag">{job.type}</span>
                            </div>
                            <ul class="space-y-2 mb-4">
                                {job.requirements.map((req) => (
                                    <li class="flex items-center gap-2 text-sm text-text-body">
                                        <span class="w-1.5 h-1.5 rounded-full bg-brand-green" />
                                        {req}
                                    </li>
                                ))}
                            </ul>
                            <a
                                href="/contact"
                                class="inline-flex items-center text-brand-blue font-medium text-sm hover:gap-2 transition-all"
                            >
                                立即應徵
                                <svg
                                    class="w-4 h-4 ml-1"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 5l7 7-7 7"
                                    />
                                </svg>
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-24 bg-brand-blue">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                準備好加入我們了嗎？
            </h2>
            <p class="text-lg text-white/85 max-w-2xl mx-auto mb-8">
                歡迎將您的履歷寄至人資信箱，或直接與我們聯繫
            </p>
            <a href="/contact" class="btn-white"> 聯絡我們 </a>
        </div>
    </section>
</Layout>
