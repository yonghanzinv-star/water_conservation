---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "禾騰技術 - 以跨域工程與智慧科技，打造韌性永續未來",
  description = "禾騰技術專注於農業水利、集水區治理及低碳永續工程，運用工程結合新興科技，協助政府部門促進農業永續與公共韌性提升。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="禾騰技術, 農業水利, 集水區治理, 永續工程, 智慧防災, 擴大灌溉, ESG, 水土保持"
    />
    <meta name="author" content="禾騰技術股份有限公司" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased flex flex-col min-h-screen">
    <!-- 暫時導向：僅開放 /sustainability/water，其餘頁面自動跳轉 -->
    <script is:inline>
      if (window.location.pathname !== '/sustainability/water') {
        window.location.replace('/sustainability/water');
      }
    </script>
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
