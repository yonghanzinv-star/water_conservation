---
import "../styles/global.css";
import "../styles/water-conservation.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "石門水庫水源地永續計畫",
  description = "跨界合作守護北台灣生命之源，推動集水區友善農業與水質保育。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="石門水庫, 水源保育, 永續工程, 友善農業, ESG"
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Noto+Sans+TC:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased min-h-screen">
    <main>
      <slot />
    </main>
  </body>
</html>
