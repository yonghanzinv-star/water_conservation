---
// Hero Section Component
---

<section
    class="relative bg-gradient-to-br from-bg-light via-white to-bg-soft py-16 lg:py-24 overflow-hidden"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <!-- Left: Content -->
            <div class="animate-fade-in-up">
                <!-- Tag -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white shadow-sm border border-brand-primary/10 mb-6"
                >
                    <span class="text-sm font-medium text-text-body">
                        Engineering <span class="text-brand-accent">✕</span> AI <span
                            class="text-brand-accent">✕</span
                        > Sustainability
                    </span>
                </div>

                <!-- Title -->
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-title leading-tight mb-6"
                >
                    跨域整合，<br />
                    <span class="text-brand-primary">驅動數位永續未來</span>
                </h1>

                <!-- Subtitle -->
                <p class="text-lg text-text-body max-w-xl mb-8 leading-relaxed">
                    禾騰技術專注於工程、產品管理與永續創新的跨領域整合。
                    我們運用 AI 與策略專案管理，推動有意義的數位與環境轉型。
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-wrap gap-4">
                    <a href="#about" class="btn-primary"> 我們的理念 </a>
                    <a href="#cta" class="btn-secondary"> 聯繫我們 </a>
                </div>
            </div>

            <!-- Right: Image -->
            <div class="relative animate-fade-in-up delay-200">
                <div class="relative max-w-md mx-auto lg:mx-0 lg:ml-auto">
                    <!-- Background decoration -->
                    <div
                        class="absolute -inset-4 bg-gradient-to-br from-brand-primary/20 to-brand-secondary/20 rounded-[32px] blur-2xl"
                    >
                    </div>

                    <!-- Image container -->
                    <div
                        class="relative aspect-[4/5] rounded-[24px] overflow-hidden shadow-2xl bg-gradient-to-br from-brand-primary to-brand-secondary p-1"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=800&h=1000&fit=crop&q=80"
                            alt="科技工作場景"
                            class="w-full h-full object-cover rounded-[20px]"
                            loading="eager"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Background decoration -->
    <div
        class="absolute top-0 right-0 w-1/3 h-1/3 bg-gradient-to-bl from-brand-secondary/5 to-transparent pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-gradient-to-tr from-brand-primary/5 to-transparent pointer-events-none"
    >
    </div>
</section>
